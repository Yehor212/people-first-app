# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred public browser/mobile key. Legacy VITE_SUPABASE_ANON_KEY still works as fallback.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Push notifications (optional)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_optional

# Google OAuth — Web Client ID from Google Cloud Console
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Social auth feature flags (public, safe for client builds)
# Provider secrets stay only in Apple/Facebook/Telegram/Supabase dashboards.
# Keep Facebook public access false until Meta business verification/App Review is approved.
VITE_ENABLE_FACEBOOK_AUTH=true
VITE_FACEBOOK_PUBLIC_ACCESS_READY=false
VITE_ENABLE_TELEGRAM_AUTH=true
# Keep Apple public access false until hosted Supabase Apple Auth reports external.apple=true.
VITE_ENABLE_APPLE_AUTH=true
VITE_APPLE_PUBLIC_ACCESS_READY=false

# Journal Magic Link live proof (CI/local operator only; never expose real values in client code)
# Free path: use Supabase Magic Link with a dedicated smoke inbox; no paid email vendor is required.
# For production reliability, verify Supabase SMTP/rate limits or configure custom SMTP before setting live-ready.
# Set VITE_JOURNAL_MAGIC_LINK_LIVE_READY=true only after a dedicated smoke inbox receives a real Supabase email.
VITE_JOURNAL_MAGIC_LINK_LIVE_READY=false
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your_supabase_management_read_token_ci_only
ZENFLOW_JOURNAL_MAGIC_LINK_SMOKE_EMAIL=journal-smoke@example.com
ZENFLOW_JOURNAL_MAGIC_LINK_SEND_SMOKE=false
ZENFLOW_JOURNAL_MAGIC_LINK_ALLOW_REAL_EMAIL=false
# This URL contains a one-time auth token. Keep the real value only in CI secrets.
ZENFLOW_JOURNAL_MAGIC_LINK_CAPTURED_URL=https://your-project-ref.supabase.co/auth/v1/verify?token=redacted&type=magiclink&redirect_to=https%3A%2F%2Fyehor212.github.io%2Fpeople-first-app%2Fdiary%3Fnav%3Dv2%26navLayout%3Dphone%26journalReset%3D00000000000000000000000000000000
ZENFLOW_JOURNAL_MAGIC_LINK_VERIFY_CAPTURED_URL=false
ZENFLOW_JOURNAL_MAGIC_LINK_CONSUME_CAPTURED_URL=false

# Sentry
# VITE_SENTRY_DSN is public runtime config. SENTRY_* values are local/CI-only
# for API checks and private source-map upload; never expose real tokens in client code.
VITE_SENTRY_DSN=your_sentry_dsn_optional
SENTRY_AUTH_TOKEN=your_sentry_auth_token_ci_only
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_BASE_URL=https://sentry.io

# Spotify (optional)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_optional

# AdMob — Android (public IDs from your AdMob app/ad units)
ZENFLOW_ADMOB_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX
ZENFLOW_APP_ADS_PUBLIC_URL=https://your-developer-domain.example/app-ads.txt
ZENFLOW_GOOGLE_PLAY_PACKAGE=com.zenflow.app
ZENFLOW_PLAY_DEVELOPER_WEBSITE=https://your-developer-domain.example/
VITE_ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
VITE_ADMOB_REWARDED_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# Required Android GMA treatment: child, teen, or unspecified.
# ZenFlow's current 13+ Android release contract requires teen.
VITE_ADMOB_AGE_RESTRICTED_TREATMENT=
# Required owner-reviewed declarations. Set each explicitly to true or false;
# leaving either blank keeps production ad initialization disabled.
VITE_ADMOB_CHILD_DIRECTED_TREATMENT=
VITE_ADMOB_UNDER_AGE_OF_CONSENT=

# AdMob — iOS
VITE_ADMOB_REWARDED_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
