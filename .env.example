# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Push notifications (optional)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_optional

# Google OAuth — Web Client ID from Google Cloud Console
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Sentry (optional)
VITE_SENTRY_DSN=your_sentry_dsn_optional

# Spotify (optional)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_optional

# AdMob — Android (public IDs from your AdMob app/ad units)
VITE_ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
VITE_ADMOB_REWARDED_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_BANNER_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# AdMob — iOS
VITE_ADMOB_REWARDED_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_BANNER_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
