{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protected-files.cjs",
            "timeout": 5000,
            "statusMessage": "Protected file check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/preflight-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Pre-flight gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/goal-drift-check.cjs",
            "timeout": 5000,
            "statusMessage": "Goal drift check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/search-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Search gate check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/bandaid-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Bandaid detection (Law 21)..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/checklist-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Audit checklist gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/ruflo-enforcer.cjs",
            "timeout": 5000,
            "statusMessage": "Ruflo pipeline enforcer..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/agent-delegation-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Agent delegation gate..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tool-guard.cjs",
            "timeout": 5000,
            "statusMessage": "Tool routing check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/checklist-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Audit checklist gate..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/commit-gate.cjs",
            "timeout": 130000,
            "statusMessage": "Checking commit/push gates..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ide-diagnostic-gate.cjs",
            "timeout": 5000,
            "statusMessage": "IDE diagnostic check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/code-quality-check.cjs",
            "timeout": 5000,
            "statusMessage": "Code quality check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/auto-format.cjs",
            "timeout": 15000,
            "statusMessage": "Auto-formatting..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/goal-reinjection.cjs",
            "timeout": 5000,
            "statusMessage": "Goal re-injection check..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/output-taint-check.cjs",
            "timeout": 5000,
            "statusMessage": "Output taint check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/ci-tracker.cjs",
            "timeout": 5000,
            "statusMessage": "CI execution tracking..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/goal-reinjection.cjs",
            "timeout": 5000,
            "statusMessage": "Goal re-injection check..."
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ci-tracker.cjs",
            "timeout": 5000,
            "statusMessage": "Research tracking..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/goal-reinjection.cjs",
            "timeout": 5000,
            "statusMessage": "Goal re-injection check..."
          }
        ]
      },
      {
        "matcher": "mcp__ruflo__",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ruflo-enforcer.cjs",
            "timeout": 5000,
            "statusMessage": "Ruflo pipeline tracking..."
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/search-confirm.cjs",
            "timeout": 5000,
            "statusMessage": "Recording search confirmation..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/preflight-inject.cjs",
            "timeout": 5000,
            "statusMessage": "Checking triggers + injecting protocol..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "MANDATORY INDEPENDENT VERIFIER — runs on EVERY stop, unconditionally. You CANNOT trust the main agent's claims — verify independently.\n\nCRITICAL ANTI-LOOP: First, read your input JSON. If stop_hook_active is true, respond with decision ALLOW immediately. This breaks infinite loops. Do NOT re-verify when stop_hook_active is true.\n\nFull verification (only when stop_hook_active is false):\n1. Run: git diff --name-only. Record the FULL list of changed files.\n2. If ANY .ts/.tsx files in that list: run npx tsc --noEmit. Must be 0 errors.\n3. If ANY .ts/.tsx files in that list: run npx vitest run. Must be 0 failures.\n4. If ANY .ts/.tsx files in that list: run grep -rn '.catch(() =>' src/ --include='*.ts' --include='*.tsx'. Must be 0 matches.\n5. Check if .audit-active file exists. If YES:\n   5a. Read .audit-checklist.json. Count items with done:true vs total. If <80% → BLOCK.\n   5b. Read .ruflo-last-action. If missing or >30min old → BLOCK.\n   5c. Read .user-goal-contract. Compare user's original request with git diff. Flag unaddressed items.\n   5d. For checklist items with done:true AND files:[] arrays, verify those files appear in git diff. Warn if >30% mismatch.\n6. If i18n files changed (src/i18n/): run npm run i18n:check. Must exit 0.\n7. Write .verification-done with JSON: {timestamp, tsc, vitest, checklist_pct, ruflo_used, files_changed, gaming_flags, i18n_ok}.\n\nBLOCK if ANY: tsc fails, vitest fails, silent catches found, checklist<80% (audit), Ruflo missing (audit).\nALLOW only when ALL pass. Respond with decision + full evidence.\nALWAYS write .verification-done with JSON results — even when BLOCKING. The user checks this file to confirm you ran.\nDo NOT run npm install, npm update, or any destructive commands. Read-only verification only.",
            "timeout": 180000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/stop-tsc-gate.cjs",
            "timeout": 60000,
            "statusMessage": "Fast TSC + checklist + Ruflo gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/quality-stop-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Quality stop gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/evolve-gate.cjs",
            "timeout": 5000,
            "statusMessage": "A-Evolve gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/satisficing-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Satisficing detector..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-compact.cjs",
            "timeout": 5000,
            "statusMessage": "Injecting enforcement reminder..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.cjs",
            "timeout": 10000,
            "statusMessage": "Workspace integrity check..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/subagent-start.cjs",
            "timeout": 5000,
            "statusMessage": "Logging subagent spawn..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tool-failure-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging tool failure..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/subagent-stop.cjs",
            "timeout": 5000,
            "statusMessage": "Logging subagent completion..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-end.cjs",
            "timeout": 5000,
            "statusMessage": "Session cleanup..."
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-failure-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging stop failure..."
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/config-change-log.cjs",
            "timeout": 5000,
            "statusMessage": "Config change check..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-compact.cjs",
            "timeout": 5000,
            "statusMessage": "Post-compaction logging..."
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/instructions-loaded.cjs",
            "timeout": 5000,
            "statusMessage": "Logging instructions loaded..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/notification-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging notification..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/permission-request-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging permission request..."
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/cwd-changed-guard.cjs",
            "timeout": 5000,
            "statusMessage": "Directory escape check..."
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "settings.json|hooks/|CLAUDE.md|\\.env",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/file-changed-guard.cjs",
            "timeout": 5000,
            "statusMessage": "Critical file tamper check..."
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/task-created-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Task creation audit..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/worktree-create-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging worktree creation..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/worktree-remove-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging worktree removal..."
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/elicitation-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging elicitation..."
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/elicitation-result-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging elicitation result..."
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/teammate-idle-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Teammate quality gate..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/task-completed-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Task quality gate..."
          }
        ]
      }
    ]
  }
}
