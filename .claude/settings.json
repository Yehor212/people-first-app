{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protected-files.cjs",
            "timeout": 5000,
            "statusMessage": "Protected file check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/preflight-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Pre-flight gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/search-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Search gate check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/bandaid-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Bandaid detection (Law 21)..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/agent-delegation-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Agent delegation gate..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tool-guard.cjs",
            "timeout": 5000,
            "statusMessage": "Tool routing check..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/commit-gate.cjs",
            "timeout": 130000,
            "statusMessage": "Checking commit/push gates..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ide-diagnostic-gate.cjs",
            "timeout": 5000,
            "statusMessage": "IDE diagnostic check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/code-quality-check.cjs",
            "timeout": 5000,
            "statusMessage": "Code quality check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/auto-format.cjs",
            "timeout": 15000,
            "statusMessage": "Auto-formatting..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/output-taint-check.cjs",
            "timeout": 5000,
            "statusMessage": "Output taint check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/ci-tracker.cjs",
            "timeout": 5000,
            "statusMessage": "CI execution tracking..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/preflight-inject.cjs",
            "timeout": 5000,
            "statusMessage": "Checking triggers + injecting protocol..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/quality-stop-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Quality stop gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/anti-skip-gate.cjs",
            "timeout": 15000,
            "statusMessage": "Anti-skip enforcement (tasks + type assertions + plan coverage)..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-compact.cjs",
            "timeout": 5000,
            "statusMessage": "Injecting enforcement reminder..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.cjs",
            "timeout": 10000,
            "statusMessage": "Workspace integrity check..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-end.cjs",
            "timeout": 5000,
            "statusMessage": "Session cleanup..."
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/config-change-log.cjs",
            "timeout": 5000,
            "statusMessage": "Config change check..."
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/cwd-changed-guard.cjs",
            "timeout": 5000,
            "statusMessage": "Directory escape check..."
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/teammate-idle-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Teammate quality gate..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/task-completed-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Task quality gate..."
          }
        ]
      }
    ]
  }
}
