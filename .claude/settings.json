{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protected-files.cjs",
            "timeout": 5000,
            "statusMessage": "Protected file check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/preflight-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Pre-flight gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/goal-drift-check.cjs",
            "timeout": 5000,
            "statusMessage": "Goal drift check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/search-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Search gate check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/bandaid-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Bandaid detection (Law 21)..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/checklist-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Audit checklist gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/ruflo-enforcer.cjs",
            "timeout": 5000,
            "statusMessage": "Ruflo pipeline enforcer..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/agent-delegation-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Agent delegation gate..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tool-guard.cjs",
            "timeout": 5000,
            "statusMessage": "Tool routing check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/checklist-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Audit checklist gate..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/commit-gate.cjs",
            "timeout": 130000,
            "statusMessage": "Checking commit/push gates..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ide-diagnostic-gate.cjs",
            "timeout": 5000,
            "statusMessage": "IDE diagnostic check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/code-quality-check.cjs",
            "timeout": 5000,
            "statusMessage": "Code quality check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/auto-format.cjs",
            "timeout": 15000,
            "statusMessage": "Auto-formatting..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/goal-reinjection.cjs",
            "timeout": 5000,
            "statusMessage": "Goal re-injection check..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/output-taint-check.cjs",
            "timeout": 5000,
            "statusMessage": "Output taint check..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/ci-tracker.cjs",
            "timeout": 5000,
            "statusMessage": "CI execution tracking..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/goal-reinjection.cjs",
            "timeout": 5000,
            "statusMessage": "Goal re-injection check..."
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ci-tracker.cjs",
            "timeout": 5000,
            "statusMessage": "Research tracking..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/goal-reinjection.cjs",
            "timeout": 5000,
            "statusMessage": "Goal re-injection check..."
          }
        ]
      },
      {
        "matcher": "mcp__ruflo__",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ruflo-enforcer.cjs",
            "timeout": 5000,
            "statusMessage": "Ruflo pipeline tracking..."
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/search-confirm.cjs",
            "timeout": 5000,
            "statusMessage": "Recording search confirmation..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/preflight-inject.cjs",
            "timeout": 5000,
            "statusMessage": "Checking triggers + injecting protocol..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "Check for uncommitted .ts/.tsx changes: run git diff --name-only and git diff --cached --name-only. If NO .ts/.tsx files in output, respond with decision allow. If .ts/.tsx changes exist, run these 3 commands: 1) npx tsc --noEmit 2) npx vitest run 3) grep -rn \".catch(() =>\" src/ --include=\"*.ts\" --include=\"*.tsx\". If ALL pass, write .verification-done with results and respond allow. If ANY fail, respond block with failure list.",
            "timeout": 180000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/quality-stop-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Quality stop gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/evolve-gate.cjs",
            "timeout": 5000,
            "statusMessage": "A-Evolve gate..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/satisficing-gate.cjs",
            "timeout": 5000,
            "statusMessage": "Satisficing detector..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-compact.cjs",
            "timeout": 5000,
            "statusMessage": "Injecting enforcement reminder..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.cjs",
            "timeout": 10000,
            "statusMessage": "Workspace integrity check..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/subagent-start.cjs",
            "timeout": 5000,
            "statusMessage": "Logging subagent spawn..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tool-failure-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging tool failure..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/subagent-stop.cjs",
            "timeout": 5000,
            "statusMessage": "Logging subagent completion..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-end.cjs",
            "timeout": 5000,
            "statusMessage": "Session cleanup..."
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-failure-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging stop failure..."
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/config-change-log.cjs",
            "timeout": 5000,
            "statusMessage": "Config change check..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-compact.cjs",
            "timeout": 5000,
            "statusMessage": "Post-compaction logging..."
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/instructions-loaded.cjs",
            "timeout": 5000,
            "statusMessage": "Logging instructions loaded..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/notification-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging notification..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/permission-request-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging permission request..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/worktree-create-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging worktree creation..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/worktree-remove-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging worktree removal..."
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/elicitation-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging elicitation..."
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/elicitation-result-log.cjs",
            "timeout": 5000,
            "statusMessage": "Logging elicitation result..."
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/teammate-idle-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Teammate quality gate..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/task-completed-gate.cjs",
            "timeout": 10000,
            "statusMessage": "Task quality gate..."
          }
        ]
      }
    ]
  }
}
