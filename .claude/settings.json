{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65",
    "RUFLOW_PLUS_AUTO_ACTIVATE": "always",
    "RUFLOW_PLUS_HEAD_ROLE": "coordinator",
    "RUFLOW_PLUS_SIMPLE_ROUTE": "solo_lightweight",
    "RUFLOW_PLUS_DEFAULT_ROUTE": "guided",
    "RUFLOW_PLUS_COMPLEX_ROUTE": "ruflow_plus"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/zenflow-auto-context.cjs --event SessionStart",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/zenflow-auto-context.cjs --event UserPromptSubmit",
            "timeout": 8
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/zenflow-auto-context.cjs --event SubagentStart",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tool-guard.cjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protected-files.cjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node .claude/hooks/test-first-gate.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|Grep|Glob|Read|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/learning/post-task-learner.cjs",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/learning/session-end-trainer.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
