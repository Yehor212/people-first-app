{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/skill-router-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/skill-router-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Routing skills"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/no-ai-template-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/no-ai-template-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Checking no-AI-template policy"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/android-visual-runtime-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/android-visual-runtime-gate.cjs')\"",
            "timeout": 10,
            "statusMessage": "Routing Android visual runtime evidence"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/production-data-integrity-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/production-data-integrity-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Routing production data integrity"
          },
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" || { printf '%s\\n' 'HOOK ERROR [spec-kit-safety-gate]: unable to resolve repository root with git rev-parse' >&2; exit 2; }; node \"$root/.codex/hooks/spec-kit-safety-gate.cjs\"; status=$?; exit \"$status\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel 2>$null; if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($root)) { [Console]::Error.WriteLine('HOOK ERROR [spec-kit-safety-gate]: unable to resolve repository root with git rev-parse'); exit 2 }; & node (Join-Path $root '.codex/hooks/spec-kit-safety-gate.cjs'); exit $LASTEXITCODE\"",
            "timeout": 10,
            "statusMessage": "Checking Spec Kit trust state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|PowerShell|pwsh|exec_command|unified_exec|apply_patch|functions.apply_patch|Edit|Write|WriteFile|CreateFile|DeleteFile|MultiEdit|StrReplaceFile|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/agent-workspace-guard.cjs\" --expected-agent codex",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/agent-workspace-guard.cjs') --expected-agent codex\"",
            "timeout": 5,
            "statusMessage": "Checking isolated agent workspace"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/change-governance-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/change-governance-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Checking change governance"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/skill-router-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/skill-router-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Checking skill routing"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/production-data-integrity-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/production-data-integrity-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Guarding production data integrity"
          },
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" || { printf '%s\\n' 'HOOK ERROR [spec-kit-safety-gate]: unable to resolve repository root with git rev-parse' >&2; exit 2; }; node \"$root/.codex/hooks/spec-kit-safety-gate.cjs\"; status=$?; exit \"$status\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel 2>$null; if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($root)) { [Console]::Error.WriteLine('HOOK ERROR [spec-kit-safety-gate]: unable to resolve repository root with git rev-parse'); exit 2 }; & node (Join-Path $root '.codex/hooks/spec-kit-safety-gate.cjs'); exit $LASTEXITCODE\"",
            "timeout": 10,
            "statusMessage": "Guarding Spec Kit trust state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|functions.apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/production-data-integrity-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/production-data-integrity-gate.cjs')\"",
            "timeout": 20,
            "statusMessage": "Checking production data diff"
          }
        ]
      },
      {
        "matcher": "Bash|Shell|PowerShell|pwsh|exec_command|unified_exec|apply_patch|functions.apply_patch|Edit|Write|WriteFile|CreateFile|DeleteFile|MultiEdit|StrReplaceFile|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" || { printf '%s\\n' 'HOOK ERROR [spec-kit-safety-gate]: unable to resolve repository root with git rev-parse' >&2; exit 2; }; node \"$root/.codex/hooks/spec-kit-safety-gate.cjs\"; status=$?; exit \"$status\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel 2>$null; if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($root)) { [Console]::Error.WriteLine('HOOK ERROR [spec-kit-safety-gate]: unable to resolve repository root with git rev-parse'); exit 2 }; & node (Join-Path $root '.codex/hooks/spec-kit-safety-gate.cjs'); exit $LASTEXITCODE\"",
            "timeout": 10,
            "statusMessage": "Reporting Spec Kit trust drift"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/no-ai-template-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/no-ai-template-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Checking no-AI-template output"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/android-visual-runtime-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/android-visual-runtime-gate.cjs')\"",
            "timeout": 10,
            "statusMessage": "Checking Android visual runtime evidence"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/production-data-integrity-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/production-data-integrity-gate.cjs')\"",
            "timeout": 20,
            "statusMessage": "Final production data integrity check"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/no-ai-template-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/no-ai-template-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Injecting no-AI-template subagent contract"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/production-data-integrity-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/production-data-integrity-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Injecting production data evidence contract"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/no-ai-template-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/no-ai-template-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Checking no-AI-template subagent output"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/production-data-integrity-gate.cjs\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.codex/hooks/production-data-integrity-gate.cjs')\"",
            "timeout": 5,
            "statusMessage": "Checking production data evidence packet"
          }
        ]
      }
    ]
  }
}
