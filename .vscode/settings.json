{
  "files.exclude": {
    "**/.playwright-cli": true,
    "**/.codex-artifacts": true,
    "**/artifacts": true,
    "**/test-artifacts": true,
    "**/output/*-audit-*": true,
    "**/output/**/xcode-derived*": true,
    "**/output/local-https-proxy": true,
    "**/src-tauri/target": true,
    "**/src-tauri/gen/schemas/* 2.json": true,
    "**/output/xcodebuild": true,
    "**/output/security": true,
    "**/output/*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*": true,
    "**/output/**/DerivedData*": true,
    "**/output/playwright/*.json": true,
    "**/src-tauri/gen/schemas/macOS-schema.json": true,
    "**/output/design-explorations": true,
    "**/output/android-emulator": true,
    "**/output/*.json": true,
    "**/output/*.txt": true,
    "**/output/*.html": true,
    "**/output/**": true
  },
  "search.exclude": {
    "**/.playwright-cli": true,
    "**/.codex-artifacts": true,
    "**/artifacts": true,
    "**/test-artifacts": true,
    "**/output/*-audit-*": true,
    "**/output/**/xcode-derived*": true,
    "**/output/local-https-proxy": true,
    "**/src-tauri/target": true,
    "**/src-tauri/gen/schemas/* 2.json": true,
    "**/output/playwright/*/**": true,
    "**/output/xcodebuild": true,
    "**/output/security": true,
    "**/output/*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*": true,
    "**/output/**/DerivedData*": true,
    "**/output/playwright/*.json": true,
    "**/src-tauri/gen/schemas/macOS-schema.json": true,
    "**/output/design-explorations": true,
    "**/output/android-emulator": true,
    "**/output/*.json": true,
    "**/output/*.txt": true,
    "**/output/*.html": true,
    "**/output/**": true
  },
  "files.watcherExclude": {
    "**/.playwright-cli/**": true,
    "**/.codex-artifacts/**": true,
    "**/artifacts/**": true,
    "**/test-artifacts/**": true,
    "**/output/*-audit-*/**": true,
    "**/output/**/xcode-derived*/**": true,
    "**/output/local-https-proxy/**": true,
    "**/src-tauri/target/**": true,
    "**/src-tauri/gen/schemas/* 2.json": true,
    "**/output/playwright/*/**": true,
    "**/output/xcodebuild/**": true,
    "**/output/security/**": true,
    "**/output/*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*/**": true,
    "**/output/**/DerivedData*/**": true,
    "**/output/playwright/*.json": true,
    "**/src-tauri/gen/schemas/macOS-schema.json": true,
    "**/output/design-explorations/**": true,
    "**/output/android-emulator/**": true,
    "**/output/*.json": true,
    "**/output/*.txt": true,
    "**/output/*.html": true,
    "**/output/**": true
  },
  "explorer.excludeGitIgnore": true,
  "git.showIgnoredFiles": false,
  "git.autoRepositoryDetection": false,
  "git.openRepositoryInParentFolders": "never",
  "git.detectWorktrees": false,
  "git.scanRepositories": [],
  "git.repositoryScanMaxDepth": 1,
  "window.title": "${rootName} — ${activeEditorShort}"
}
