{
  "defaultBudgets": {
    "maxLongTaskMs": 500,
    "longAnimationFrameWarnMs": 250,
    "longAnimationFrameBlockingWarnMs": 120
  },
  "settleMs": 4500,
  "routeGroups": [
    {
      "profile": "phone",
      "viewport": { "width": 449, "height": 698 },
      "contextOptions": {
        "viewport": { "width": 449, "height": 698 },
        "deviceScaleFactor": 2,
        "isMobile": true,
        "hasTouch": true
      },
      "routes": [
        { "name": "home-v1-phone", "path": "?navLayout=phone" },
        {
          "name": "orb-v2-phone",
          "path": "orb/?nav=v2&navLayout=phone",
          "readySelector": "[data-testid=\"orb-page-rim-glow\"] [data-orb-visual-ready=\"true\"]"
        },
        {
          "name": "habits-v2-phone",
          "path": "habits/?nav=v2&navLayout=phone",
          "readySelector": "[data-testid=\"habits-hero-empty\"], [data-testid^=\"hero-group-\"]"
        },
        {
          "name": "diary-v2-phone",
          "path": "diary/?nav=v2&navLayout=phone",
          "readySelector": "[data-testid=\"journal-compact-empty-list\"], [data-testid=\"journal-empty-list\"]"
        },
        {
          "name": "settings-v2-phone",
          "path": "settings/?nav=v2&navLayout=phone",
          "readySelector": "[data-testid=\"settings-page-control-card\"], [data-testid=\"settings-page-sections\"]"
        },
        {
          "name": "desktop-dock-phone",
          "path": "desktop?navLayout=phone",
          "readySelector": "[data-testid=\"desktop-download-page\"]"
        }
      ]
    },
    {
      "profile": "desktop",
      "viewport": { "width": 1440, "height": 900 },
      "contextOptions": {
        "viewport": { "width": 1440, "height": 900 },
        "deviceScaleFactor": 1,
        "isMobile": false,
        "hasTouch": false
      },
      "routes": [
        { "name": "home-v1-desktop", "path": "" },
        {
          "name": "orb-v2-desktop",
          "path": "orb/?nav=v2",
          "readySelector": "[data-testid=\"orb-page-rim-glow\"] [data-orb-visual-ready=\"true\"]"
        },
        {
          "name": "habits-v2-desktop",
          "path": "habits/?nav=v2",
          "readySelector": "[data-testid=\"habits-hero-empty\"], [data-testid^=\"hero-group-\"]"
        },
        {
          "name": "diary-v2-desktop",
          "path": "diary/?nav=v2",
          "readySelector": "[data-testid=\"journal-compact-empty-list\"], [data-testid=\"journal-empty-list\"]"
        },
        {
          "name": "settings-v2-desktop",
          "path": "settings/?nav=v2",
          "readySelector": "[data-testid=\"settings-page-control-card\"], [data-testid=\"settings-page-sections\"]"
        },
        {
          "name": "desktop-dock-desktop",
          "path": "desktop",
          "readySelector": "[data-testid=\"desktop-download-page\"]"
        }
      ]
    }
  ]
}
