{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yehor212/people-first-app/specs/001-pending-batch-delivery/contracts/delivery-evidence.schema.json",
  "title": "ZenFlow pending batch delivery evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "generated_at",
    "owner_baseline",
    "snapshot",
    "reconciliation",
    "excluded_artifacts",
    "verification",
    "github_delivery",
    "verdict"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "feature_id": { "const": "001-pending-batch-delivery" },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "owner_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "status_record_count", "status_sha256"],
      "properties": {
        "head": { "$ref": "#/$defs/gitSha" },
        "branch": { "type": "string", "minLength": 1 },
        "status_record_count": { "type": "integer", "minimum": 0 },
        "status_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "parent", "path_count", "path_sha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "parent": { "$ref": "#/$defs/gitSha" },
        "path_count": { "type": "integer", "minimum": 0 },
        "path_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_commit", "main_commit", "counts", "total"],
      "properties": {
        "checkpoint_commit": { "$ref": "#/$defs/gitSha" },
        "main_commit": { "$ref": "#/$defs/gitSha" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["already_in_main", "preserved_net_change", "superseded_by_main", "integrated_resolution"],
          "properties": {
            "already_in_main": { "type": "integer", "minimum": 0 },
            "preserved_net_change": { "type": "integer", "minimum": 0 },
            "superseded_by_main": { "type": "integer", "minimum": 0 },
            "integrated_resolution": { "type": "integer", "minimum": 0 }
          }
        },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "excluded_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\.dccache$" }
    },
    "verification": {
      "type": "array",
      "items": { "$ref": "#/$defs/verificationReceipt" }
    },
    "github_delivery": {
      "type": "object",
      "additionalProperties": true,
      "required": ["branch", "status"],
      "properties": {
        "branch": { "const": "codex/pending-898-speckit-batch" },
        "status": {
          "enum": ["local", "pushed", "pull_request_open", "checks_green", "merged", "main_checks_green"]
        }
      }
    },
    "verdict": { "enum": ["GO", "STOP", "ASK"] }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceStatus": { "enum": ["VERIFIED", "FAIL", "UNVERIFIED", "SKIP"] },
    "verificationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "command": { "type": "string" },
        "scope": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "status": { "$ref": "#/$defs/evidenceStatus" },
        "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
