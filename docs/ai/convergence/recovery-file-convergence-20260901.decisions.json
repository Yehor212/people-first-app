        "pathPattern": "^scripts/audio-review/(?:CC0_KIMI_REVIEW_README\\.md|cc0-kimi-audio-(?:config|core|ffmpeg)\\.mjs|generate-cc0-kimi-review-pack\\.mjs|__tests__/(?:cc0-kimi-audio-review-workflow|generate-cc0-kimi-review-pack)\\.test\\.mjs)$"
