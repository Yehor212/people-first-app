{
  "schema": "zenflow-recovery-file-convergence-decisions-v1",
  "rules": [
    {
      "id": "audio-first-party-review-current-owner",
      "selector": {
        "pathPattern": "^(?:scripts/audio-review/(?:README\\.md|generate-first-party-review-pack\\.mjs|__tests__/(?:generate-first-party-review-pack|first-party-audio-review-workflow)\\.test\\.mjs)|\\.github/workflows/first-party-audio-review\\.yml|docs/audio/first-party-kimi-audio-reconstruction-spec\\.json|docs/superpowers/(?:specs|plans)/2026-08-24-first-party-kimi-audio-reconstruction(?:-design)?\\.md)$"
      },
      "disposition": "SUPERSEDED_WITH_EVIDENCE",
      "evidence": [
        "scripts/audio-review/__tests__/generate-first-party-review-pack.test.mjs#3 tests pass",
        "scripts/audio-review/__tests__/first-party-audio-review-workflow.test.mjs#least-privilege workflow passes",
        "scripts/audio-review/generate-first-party-review-pack.mjs#current restored non-Kimi clean-room owner"
      ]
    },
    {
      "id": "audio-legacy-mjs-cc0-superseded-by-python-review-tool",
