      "selector": {
        "pathPattern": "^docs/(?:audio/(?:hyperfocus-.*|audio-product-ops-policy\\.md|non-hyperfocus-.*)|superpowers/plans/2026-06-(?:17-cross-platform-audio-contract|19-hyperfocus-three-level-audio|29-hyperfocus-rain-wind-audio-approval)\\.md)$"
