    {
      "id": "audio-current-contract-tests",
      "selector": {
        "pathPattern": "^scripts/__tests__/(?:hyperfocus-nature-soundscape-contract|audio-blind-spots-contract|check-app-audio-assets|check-hyperfocus-audio-assets)\\.test\\.(?:ts|mjs)$"
