{
  "name": "zenflow",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "tokens:build": "style-dictionary build --config src/design-tokens/sd.config.mjs",
    "build": "npm run tokens:build && vite build --configLoader runner",
    "build:dev": "npm run tokens:build && vite build --configLoader runner --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:release": "vitest run --configLoader runner src/pages/nav-v2/__tests__/DiaryRouteLoader.test.ts src/features/journal/__tests__/JournalEntryList.spaces.test.tsx src/features/journal/__tests__/JournalEntryList.spaceParity.test.tsx src/components/state-of-mind/__tests__/canonicalOrbInvariant.test.ts src/storage/__tests__/eventSync.test.ts src/lib/__tests__/offlineQueueHandlers.test.ts src/observability/__tests__/runtimeFlightRecorder.test.ts src/observability/__tests__/syncHealthRecorder.test.ts src/components/sync/__tests__/SyncHealthCard.test.tsx src/hooks/__tests__/useDeltaSyncEffects.test.ts",
    "test:coverage": "vitest run --configLoader runner --coverage --testTimeout=60000 --no-file-parallelism --maxWorkers=1",
    "test:i18n": "vitest run --configLoader runner test/i18n.test.ts",
    "i18n:check": "npx tsx scripts/check-i18n.ts && npm run i18n:v2-copy",
    "i18n:v2-copy": "npx tsx scripts/check-v2-ui-copy.ts",
    "i18n:deep": "npx tsx scripts/check-i18n-deep.ts",
    "build:android": "cross-env CAPACITOR_BUILD=true npm run tokens:build && cross-env CAPACITOR_BUILD=true vite build --configLoader runner && cross-env CAPACITOR_BUILD=true node scripts/capacitor-prune-assets.cjs",
    "build:ios": "cross-env CAPACITOR_BUILD=true npm run tokens:build && cross-env CAPACITOR_BUILD=true vite build --configLoader runner && cross-env CAPACITOR_BUILD=true node scripts/capacitor-prune-assets.cjs",
    "desktop:dev": "node scripts/run-with-msvc.cjs \"tauri dev\"",
    "desktop:build": "node scripts/run-with-msvc.cjs \"tauri build\"",
    "desktop:check": "node scripts/check-desktop-exe-contract.cjs && node scripts/run-with-msvc.cjs \"node scripts/check-desktop-toolchain.cjs && tauri info\"",
    "desktop:sign": "node scripts/sign-desktop-windows.cjs",
    "desktop:release:check": "node scripts/check-desktop-release-readiness.cjs",
    "desktop:release:check:dev": "node scripts/check-desktop-release-readiness.cjs --allow-unsigned-dev",
    "assets:logos": "node scripts/generate-icons.cjs",
    "assets:logos:check": "node scripts/check-brand-logo-assets.cjs",
    "assets:logos:proof": "node scripts/generate-brand-logo-proof-sheet.cjs",
    "google-play:assets": "node scripts/generate-google-play-assets.cjs",
    "google-play:app-ads": "node scripts/write-app-ads.cjs",
    "google-play:app-ads:check": "node scripts/write-app-ads.cjs --check",
    "google-play:assets:check": "node scripts/check-google-play-release-assets.cjs",
    "desktop:store:assets": "node scripts/generate-microsoft-store-logo-assets.cjs",
    "desktop:store:assets:check": "node scripts/check-microsoft-store-logo-assets.cjs",
    "desktop:store:package": "node scripts/create-microsoft-store-msix.cjs",
    "desktop:store:check": "npm run assets:logos:check && node scripts/check-microsoft-store-msix-contract.cjs",
    "cap:sync": "npm run build:android && npx cap sync && cross-env CAPACITOR_BUILD=true node scripts/capacitor-prune-assets.cjs && node scripts/normalize-android-config.cjs && node scripts/normalize-ios-config.cjs && node scripts/normalize-ios-spm.cjs",
    "cap:sync:android": "npm run build:android && npx cap sync android && cross-env CAPACITOR_BUILD=true node scripts/capacitor-prune-assets.cjs && node scripts/normalize-android-config.cjs",
    "cap:sync:ios": "npm run build:ios && npx cap sync ios && cross-env CAPACITOR_BUILD=true node scripts/capacitor-prune-assets.cjs && node scripts/normalize-ios-config.cjs && node scripts/normalize-ios-spm.cjs",
    "cap:open:android": "npx cap open android",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check:colors": "npx tsx scripts/check-hardcoded-colors.ts",
    "check:strings": "node --experimental-strip-types scripts/check-hardcoded-strings.ts",
    "audit:check": "npm audit --audit-level=high",
    "security:scan": "npm run audit:check && npx snyk code test",
    "constitution:check": "node --experimental-strip-types scripts/check-constitution.ts",
    "ratchet:check": "npx tsx scripts/check-ratchet.ts",
    "ratchet:update": "npx tsx scripts/check-ratchet.ts --update",
    "enforcement:check": "npx tsx scripts/check-enforcement-health.ts",
    "check:best-practices": "node scripts/check-best-practices-gate.cjs",
    "check:v2-paper": "npx tsx scripts/check-v2-paper-theme.ts",
    "check:canonical-orbs": "node scripts/check-canonical-orbs.mjs",
    "check:task-completion": "node scripts/check-task-completion-protocol.cjs",
    "check:subagent-governance": "node scripts/check-subagent-teamlead-governance.mjs",
    "check:sync-contract": "node scripts/check-sync-contract.cjs",
    "check:auth-providers": "node scripts/check-auth-providers.cjs",
    "check:facebook-auth-public": "node scripts/check-facebook-auth-public.cjs",
    "check:facebook-auth-live": "node scripts/check-facebook-auth-live.cjs",
    "check:telegram-oidc-live": "node scripts/check-telegram-oidc-live.cjs",
    "check:apple-auth-public": "node scripts/check-apple-auth-public.cjs",
    "check:apple-auth-activation": "node scripts/check-apple-auth-activation.cjs",
    "check:apple-auth-live": "node scripts/check-apple-auth-live.cjs",
    "check:apple-auth-complete": "npm run check:auth-providers -- --strict && npm run check:apple-auth-public && cross-env ZENFLOW_APPLE_AUTH_LIVE_REQUIRED=true npm run check:apple-auth-live",
    "generate:apple-client-secret": "node scripts/generate-apple-client-secret.cjs",
    "apply:apple-auth-live": "node scripts/apply-apple-auth-live.cjs",
    "check:sentry": "node scripts/check-sentry-status.cjs",
    "check:sentry-readiness": "node scripts/check-sentry-readiness.cjs",
    "smoke:sentry-api": "node scripts/smoke-sentry-api.cjs",
    "check:telegram-control": "npm --prefix tools/telegram-control run typecheck && npm --prefix tools/telegram-control run test && npm --prefix tools/telegram-control run check:workflow && npm --prefix tools/telegram-control run check:secrets && npm --prefix tools/telegram-control run smoke:local && npm --prefix tools/telegram-control run verify:config && npm --prefix tools/telegram-control run setup:kv -- --dry-run && npm --prefix tools/telegram-control run github-app:manifest -- --base-url https://example.invalid && npm --prefix tools/telegram-control run github-app:local-flow -- --dry-run --base-url https://example.invalid && npm --prefix tools/telegram-control run telegram:doctor && npm --prefix tools/telegram-control run set-webhook -- --dry-run && npm --prefix tools/telegram-control run set-bot-ui -- --dry-run && npm --prefix tools/telegram-control run secrets:bootstrap && npm --prefix tools/telegram-control run secrets:install-generated -- --dry-run && npm --prefix tools/telegram-control run secrets:install-account -- --dry-run && npm --prefix tools/telegram-control run secrets:prompt-account -- --dry-run && npm --prefix tools/telegram-control run set-github-callback-url -- --dry-run --base-url https://example.invalid && npm --prefix tools/telegram-control run activation:run && npm --prefix tools/telegram-control run activation:doctor",
    "check:visual": "npm run check:canonical-orbs && npm run assets:logos:check && npx tsx scripts/check-visual-guards.ts && npm run check:v2-paper",
    "check:all": "npm run typecheck && npm run lint && npm run i18n:check && npm run i18n:deep && npm run check:colors && npm run check:visual",
    "smoke:v2-splash": "node scripts/smoke-v2-splash.cjs",
    "smoke:chrome-performance": "node scripts/smoke-chrome-performance.cjs",
    "smoke:sync-health": "node scripts/smoke-sync-health.cjs",
    "smoke:sync-account": "node scripts/smoke-sync-account.cjs",
    "smoke:telegram-sync-drill": "node scripts/smoke-telegram-sync-drill.cjs",
    "check:github-sync-secrets": "node scripts/check-github-sync-secrets.cjs",
    "check:github-sentry-secrets": "node scripts/check-github-sentry-secrets.cjs",
    "apply:sentry-github": "node scripts/apply-sentry-github.cjs",
    "check:desktop-exe-contract": "node scripts/check-desktop-exe-contract.cjs",
    "setup:sync-test-account": "node scripts/setup-sync-test-account.cjs",
    "diagnose:dev-performance": "node scripts/diagnose-dev-performance.cjs",
    "cleanup:dev-processes": "node scripts/cleanup-dev-processes.cjs",
    "ci:preflight": "npx eslint . --max-warnings=0 && npm run typecheck && npm run i18n:check && npm run i18n:deep && npm run oxlint && npm run check:circular && npm run test:coverage && npm run tokens:build && vite build --configLoader runner && npm run verify:tailwind && npm run check:size && npm run check:canonical-orbs && npm run check:best-practices && npm run check:rag && npm run check:task-completion && npm run check:sync-contract && npm run ratchet:check",
    "ci:remote": "npx tsx scripts/check-remote-ci.ts",
    "ci:remote:wait": "npx tsx scripts/check-remote-ci.ts --wait",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:v2:smoke": "playwright test e2e/deploy-smoke.spec.ts --project=chromium",
    "test:e2e:v2:critical": "playwright test e2e/deploy-smoke.spec.ts e2e/orb-renderer-lifecycle.spec.ts e2e/nav-v2-settings.spec.ts --project=chromium",
    "test:e2e:v2:visual": "playwright test e2e/nav-v2.spec.ts e2e/design-system.spec.ts --project=chromium",
    "test:e2e:v2:journal": "playwright test e2e/journal-hub-v2.spec.ts e2e/journal-sidebar.spec.ts --project=chromium",
    "test:e2e:v2:diary-wallpaper": "npm run test:e2e:v2:diary-wallpaper:web && npm run test:e2e:v2:diary-wallpaper:desktop && npm run test:e2e:v2:diary-wallpaper:android && npm run test:e2e:v2:diary-wallpaper:ios",
    "test:e2e:v2:diary-wallpaper:web": "cross-env ZENFLOW_PLAYWRIGHT_USE_LOCAL_SERVER=true playwright test e2e/diary-wallpaper-web-pwa.spec.ts --project=chromium --workers=1",
    "test:e2e:v2:diary-wallpaper:desktop": "cross-env ZENFLOW_PLAYWRIGHT_USE_LOCAL_SERVER=true playwright test e2e/diary-wallpaper-desktop-tauri.spec.ts --project=chromium --workers=1",
    "test:e2e:v2:diary-wallpaper:android": "playwright test e2e/android-diary-v2.spec.ts --config=e2e/helpers/android-diary/playwright.config.ts",
    "test:e2e:v2:diary-wallpaper:ios": "playwright test e2e/ios-diary-v2.spec.ts --config=e2e/helpers/ios-diary/playwright.config.ts",
    "test:e2e:v2:diary-pwa-offline": "playwright test e2e/diary-pwa-offline.spec.ts --config=e2e/helpers/pwa-offline/playwright.config.ts",
    "test:e2e:v2:habits": "playwright test e2e/habits-a11y-44px.spec.ts e2e/habits-metrics.spec.ts --project=chromium",
    "prepare": "husky",
    "enforcement:metrics": "npx tsx scripts/enforcement-metrics.ts",
    "knip": "knip",
    "oxlint": "oxlint -c .oxlintrc.json src/",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "check:size": "size-limit",
    "verify:tailwind": "node scripts/verify-tailwind-css.cjs",
    "doc-counts": "node scripts/doc-counts.cjs --check",
    "doc-counts:update": "node scripts/doc-counts.cjs --update",
    "doc-counts:print": "node scripts/doc-counts.cjs --print",
    "ai:ruflow-plus:sync": "node scripts/sync-ruflow-plus.mjs --write",
    "ai:ruflow-plus:check": "node scripts/sync-ruflow-plus.mjs --check",
    "ai:context": "node tools/zenflow-context/server.mjs --cli",
    "ai:context:mcp": "node tools/zenflow-context/server.mjs",
    "ai:context:check": "node tools/zenflow-context/server.mjs --cli --context startup --topic \"startup verification\" --max-chars 5000",
    "ai:context:auto": "node tools/zenflow-context/auto-context.mjs",
    "ai:context:auto-check": "node tools/zenflow-context/auto-context.mjs --check",
    "check:agent-context": "node scripts/check-agent-context.mjs",
    "check:types-fresh": "node scripts/check-types-freshness.cjs",
    "check:supabase-migration-prefixes": "node scripts/check-supabase-migration-prefixes.cjs",
    "check:licenses": "node scripts/check-oss-licenses.cjs",
    "bundle:report": "node scripts/bundle-report.cjs",
    "bundle:report:strict": "node scripts/bundle-report.cjs --strict",
    "a11y:icons": "node scripts/a11y-icons-audit.cjs --top 20",
    "assets:splash:dark": "node scripts/generate-dark-splash.cjs",
    "check:sentry-artifacts": "node scripts/check-sentry-artifacts.cjs",
    "activate:apple-auth-live": "node scripts/activate-apple-auth-live.cjs",
    "smoke:public-auth": "node scripts/smoke-public-auth-providers.cjs",
    "smoke:interactive-auth": "node scripts/smoke-interactive-auth-completion.cjs",
    "check:supabase-publishable-key": "node scripts/check-supabase-publishable-key.cjs",
    "rag:search:free": "npx tsx scripts/rag/search-project-docs.ts",
    "rag:preflight": "npx tsx scripts/rag/preflight.ts",
    "rag:smoke:free": "npx tsx scripts/rag/smoke-free-rag.ts",
    "rag:audit:free": "npx tsx scripts/rag/audit-free-rag.ts",
    "check:rag": "npm run rag:smoke:free && npm run rag:audit:free"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-community/safe-area": "^8.0.1",
