{
  "name": "zenflow",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "tokens:build": "style-dictionary build --config src/design-tokens/sd.config.mjs",
    "build": "npm run tokens:build && vite build",
    "build:dev": "npm run tokens:build && vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:i18n": "vitest run test/i18n.test.ts",
    "i18n:check": "npx tsx scripts/check-i18n.ts",
    "build:android": "cross-env CAPACITOR_BUILD=true npm run tokens:build && cross-env CAPACITOR_BUILD=true vite build",
    "cap:sync": "npm run build:android && npx cap sync",
    "cap:sync:android": "npm run build:android && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "typecheck": "tsc --noEmit",
    "check:colors": "npx tsx scripts/check-hardcoded-colors.ts",
    "check:strings": "npx tsx scripts/check-hardcoded-strings.ts",
    "audit:check": "npm audit --audit-level=high",
    "constitution:check": "npx tsx scripts/check-constitution.ts",
    "ratchet:check": "npx tsx scripts/check-ratchet.ts",
    "ratchet:update": "npx tsx scripts/check-ratchet.ts --update",
    "enforcement:check": "npx tsx scripts/check-enforcement-health.ts",
    "check:visual": "npx tsx scripts/check-visual-guards.ts",
    "check:all": "npm run typecheck && npm run lint && npm run i18n:check && npm run check:colors && npm run check:visual",
    "ci:preflight": "npx eslint . --max-warnings=96 && tsc --noEmit && npm run i18n:check && npm run oxlint && npm run check:circular && vitest run --coverage && npm run tokens:build && vite build && npm run check:size && npm run ratchet:check",
    "ci:remote": "npx tsx scripts/check-remote-ci.ts",
    "ci:remote:wait": "npx tsx scripts/check-remote-ci.ts --wait",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "prepare": "husky",
    "enforcement:metrics": "npx tsx scripts/enforcement-metrics.ts",
    "knip": "knip",
    "oxlint": "oxlint -c .oxlintrc.json src/",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "check:size": "size-limit",
    "doc-counts": "node scripts/doc-counts.cjs --check",
    "doc-counts:update": "node scripts/doc-counts.cjs --update",
    "doc-counts:print": "node scripts/doc-counts.cjs --print",
    "check:types-fresh": "node scripts/check-types-freshness.cjs",
    "check:licenses": "node scripts/check-oss-licenses.cjs",
    "bundle:report": "node scripts/bundle-report.cjs",
    "bundle:report:strict": "node scripts/bundle-report.cjs --strict",
    "a11y:icons": "node scripts/a11y-icons-audit.cjs --top 20"
  },
  "dependencies": {
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.3.1",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/literata": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^10.38.0",
    "@supabase/supabase-js": "^2.45.6",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tanstack/react-query": "^5.99.1",
    "@tanstack/react-virtual": "^3.13.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.2",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.26.2",
    "jspdf": "^4.2.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.462.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^3.0.19",
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.58.1",
    "@size-limit/file": "^12.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^5.0.2",
    "fast-check": "^3.23.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.0",
    "knip": "^6.3.0",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.2.7",
    "lovable-tagger": "^1.1.13",
    "madge": "^8.0.0",
    "oxlint": "^1.58.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "size-limit": "^12.0.1",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.4.1",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4",
    "workbox-build": "^7.1.0",
    "workbox-core": "^7.1.0",
    "workbox-expiration": "^7.1.0",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint"
    ],
    "src/**/*.{ts,tsx}": [
      "oxlint -c .oxlintrc.json"
    ]
  }
}
